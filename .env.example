# Copy to .env and fill in what you need. Every variable is optional in DEMO mode.

# ---------------------------------------------------------------------------
# Mode
#   demo: local JSON files. No API keys needed: questions are answered by an
#         offline keyword "AI", or by Gemini if GEMINI_API_KEY is set below.
#   live: Gemini + Google Sheets (FAQ) + Google Calendar (bookings).
# ---------------------------------------------------------------------------
MODE=demo

# ---------------------------------------------------------------------------
# Telegram
#   Token from @BotFather. Leave empty to chat with the bot in your terminal.
#   OWNER_TELEGRAM_ID is your numeric user id (send /whoami to the bot).
#   It enables /today, /bookings, /cancel and new-booking notifications.
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
OWNER_TELEGRAM_ID=

# ---------------------------------------------------------------------------
# Gemini (optional in DEMO, required in LIVE)
#   GEMINI_API_KEY: https://aistudio.google.com/apikey
#   GEMINI_MODEL: any model your key lists for generateContent. Lite models
#     answer in 1-3 s; bigger ones are slower and hit free-tier limits sooner.
#   GEMINI_THINKING_LEVEL: empty = the model's default. "low" speeds up bigger
#     models (not every model accepts every level).
#   If Gemini fails or takes over 12 s, the offline assistant answers instead.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_THINKING_LEVEL=

# ---------------------------------------------------------------------------
# LIVE mode only
#   GOOGLE_SERVICE_ACCOUNT_FILE: JSON key of a service account that has
#     access to the sheet (Viewer) and the calendar (Make changes to events).
#   GOOGLE_SHEET_ID: the long id in the sheet URL (/d/<id>/edit).
#   GOOGLE_CALENDAR_ID: Calendar settings -> "Integrate calendar" -> Calendar ID.
# ---------------------------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/service_account.json
GOOGLE_SHEET_ID=
GOOGLE_CALENDAR_ID=

# ---------------------------------------------------------------------------
# Booking rules
# ---------------------------------------------------------------------------
TIMEZONE=Asia/Baku
# Phone numbers typed without "+" are treated as local numbers of this country.
DEFAULT_COUNTRY_CODE=994
BOOKING_DAYS_AHEAD=14
SLOT_STEP_MINUTES=30
MIN_LEAD_MINUTES=60

# ---------------------------------------------------------------------------
# Safety
# ---------------------------------------------------------------------------
RATE_LIMIT_MESSAGES=10
RATE_LIMIT_WINDOW_SECONDS=60
MAX_INPUT_CHARS=500

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
# How long the Google Sheet FAQ is cached (seconds).
FAQ_CACHE_SECONDS=300
LOG_LEVEL=INFO
